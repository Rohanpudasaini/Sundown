# Example Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================
# Application Configuration
# ============================================
APP_NAME=Sundown
VERSION=1.0.0
DEBUG=false

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=sundown
POSTGRES_PASSWORD=change-this-to-a-secure-password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sundown

# ============================================
# MinIO Configuration
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-to-a-secure-password
MINIO_ENDPOINT=localhost:9000

# ============================================
# Security Configuration
# ============================================
# Generate a secure secret key:
# openssl rand -hex 32
SECRET_KEY=your-secret-key-here-replace-this-with-a-real-key-generated-by-openssl
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Email / SMTP Configuration
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=SunDown
SMTP_USE_TLS=true
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
# Full URL of your frontend (used in reset-password links)
FRONTEND_URL=http://localhost:3000

# ============================================
# Logging Configuration
# ============================================
LOG_EXCEPTIONS=true
LOG_EXCLUDE_EXCEPTION_CODES=[]

# ============================================
# Notes
# ============================================
# - Never commit the actual .env file to version control
# - Keep your SECRET_KEY secure and unique
# - Use strong passwords for database and MinIO
# - In production, set DEBUG=false
# - Adjust ACCESS_TOKEN_EXPIRE_MINUTES based on security requirements

# ============================================
# LLM Configuration
# ============================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here